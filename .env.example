# Supabase Configuration
# Replace these placeholders with your actual Supabase project credentials.
# You can find these in your Supabase Dashboard under Settings > API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Canonical origin, used for SEO metadata, the sitemap and links inside emails.
NEXT_PUBLIC_SITE_URL=https://gharibperfumes.com

# UAE trade licence number shown on /terms. Leave unset and the page omits the
# claim rather than printing a placeholder.
NEXT_PUBLIC_TRADE_LICENCE=

# ---------------------------------------------------------------------------
# Transactional email (Resend) — order confirmation, out-for-delivery, delivered
#
# Without these the store runs normally but sends no notifications; every
# skipped send is logged with a warning. Get a key at resend.com/api-keys.
#
# RESEND_FROM_EMAIL must use a domain you have VERIFIED in Resend, otherwise
# delivery is rejected. Resend's onboarding@resend.dev works for a first test
# but only delivers to your own account address.
# ---------------------------------------------------------------------------

RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Gharib <orders@gharibperfumes.com>

# Optional — where customer replies should land.
RESEND_REPLY_TO=info@gharib.com

# ---------------------------------------------------------------------------
# Abandoned-cart recovery (migration 45)
#
# The shared secret the recovery job authenticates with. It must match the row
# stored in the database, or nothing sends:
#
#   INSERT INTO public.app_config (name, value)
#   VALUES ('cart_recovery', replace(gen_random_uuid()::TEXT || gen_random_uuid()::TEXT, '-', ''))
#   ON CONFLICT (name) DO UPDATE SET value = EXCLUDED.value, updated_at = now();
#
#   SELECT value FROM public.app_config WHERE name = 'cart_recovery';
#
# Then schedule, hourly:
#   curl -X POST https://<your-domain>/api/cart-recovery \
#        -H "Authorization: Bearer $CART_RECOVERY_SECRET"
#
# Leave it unset and no reminders are sent; nothing else about the store
# changes. A signed-in admin can also trigger a run from the admin panel, but
# the secret must still be set in both places for the database to allow it.
# ---------------------------------------------------------------------------

CART_RECOVERY_SECRET=

# ---------------------------------------------------------------------------
# AI perfume concierge (migration 53)
#
# The chat concierge at /api/concierge runs on OpenAI. Without the key the
# widget still renders; every message answers with friendly "away from the
# desk" copy and nothing crashes. Get a key at platform.openai.com/api-keys.
#
# CONCIERGE_MODEL is optional — it overrides the default (gpt-5.4-mini)
# without a code change.
#
# CONCIERGE_VISION_MODEL is for the "photograph a bottle" feature (migration
# 58). Leave it empty and the same model reads pictures. Whether it CAN is a
# property of whichever model CONCIERGE_MODEL names, not something the code can
# know: send one photograph through after deploying, and if the reply opens with
# "I could not read that photograph just now", name an image-capable model here.
# The turn degrades to an ordinary text answer meanwhile, so nothing breaks.
#
# CONCIERGE_VISION=off switches photograph reading off entirely — the camera
# button disappears from the reply path and any image sent is simply ignored.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=sk-your-openai-key-here
CONCIERGE_MODEL=
CONCIERGE_VISION_MODEL=
CONCIERGE_VISION=
